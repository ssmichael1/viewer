import {
    Button,
    VerticalBox,
    HorizontalBox,
    ComboBox,
    GridBox,
    Palette,
    Slider,
} from "std-widgets.slint";
import { ToggleSwitch } from "toggleswitch.slint";
import {
    DragArea,
    PlotBox,
    PlotRange,
    PlotData,
    MarkerType,
} from "plotting.slint";

import { Shared } from "shared.slint";
import { GroupBox, GroupBoxCollapsible } from "groupbox.slint";
import { SVBonyCapDisp } from "svbony.slint";

import { VerticalSplitPane } from "splitpane.slint";
import { TabBar, TabPage, TabData } from "tabwindow.slint";
import { ImageViewer } from "imageviewer.slint";
import { EnhancedSlider } from "enhancedslider.slint";
import { Toolbar } from "toolbar.slint";

export component AppWindow inherits Window {
    title: "Camera Viewer";
    min-height: 600px;
    min-width: 800px;
    preferred-height: 1024px;
    preferred-width: 1200px;

    in-out property <image> camframe;
    in property <image> colormap_image;
    in-out property <int> camframe_width: 512;
    in-out property <int> camframe_height: 512;
    in-out property <string> meantext: " ";
    in-out property <string> vartext: " ";
    in-out property <[color]> colors;

    property <bool> show_colorbar: true;
    property <bool> show-axes: true;
    in-out property <int> xpix: 0;
    in-out property <int> ypix: 0;
    in-out property <int> valatpix: 0;

    // Called from .slint when user hits Ctrl/Cmd+Q
    callback quit_requested();

    // Route key events to our handler even if nothing else is focused
    forward-focus: kb;

    kb := FocusScope {
        focus-on-click: true;

        // Intercept key presses here
            capture-key-pressed(e) => {
            if ((e.modifiers.control || e.modifiers.meta)   // Ctrl on Win/Linux, Cmd on macOS
                    && (e.text == "q" || e.text == "Q")) {
                root.quit_requested();
                accept
            } else {
                reject
            }
        }
    }

    VerticalLayout {
        
        // Microsoft Office-style Toolbar
        toolbar := Rectangle {
            height: 72px;
            background: Palette.background;
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                padding-top: 14px;
                spacing: 6px;
                
                // Toggle axes button
                toolbar-button-axes := Rectangle {
                    width: 44px;
                    height: 48px;
                    border-radius: 4px;
                    background: root.show-axes ? Palette.accent-background.with-alpha(0.2) : (ta-axes.has-hover ? (ta-axes.pressed ? Palette.alternate-background.darker(0.1) : Palette.alternate-background) : transparent);
                    ta-axes := TouchArea {
                        clicked => {
                            root.show-axes = !root.show-axes;
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        Image {
                            source: @image-url("icon-axes.svg");
                            width: 24px;
                            height: 24px;
                            colorize: root.show-axes ? Palette.accent-background : Palette.foreground;
                        }

                        Text {
                            text: "Axes";
                            font-size: 12px;
                            color: root.show-axes ? Palette.accent-background : Palette.foreground;
                            horizontal-alignment: center;
                            font-weight: root.show-axes ? 600 : 400;
                            font-family: "SF Pro Text";
                        }
                    }
                }
                
                // Toggle colorbar button
                toolbar-button-colorbar := Rectangle {
                    width: 54px;
                    height: 48px;
                    border-radius: 4px;
                    background: root.show_colorbar ? Palette.accent-background.with-alpha(0.2) : (ta-colorbar.has-hover ? (ta-colorbar.pressed ? Palette.alternate-background.darker(0.1) : Palette.alternate-background) : transparent);
                    ta-colorbar := TouchArea {
                        clicked => {
                            root.show_colorbar = !root.show_colorbar;
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        Image {
                            source: @image-url("icon-colorbar.svg");
                            width: 24px;
                            height: 24px;
                            colorize: root.show_colorbar ? Palette.accent-background : Palette.foreground;
                        }

                        Text {
                            text: "Colorbar";
                            font-size: 12px;
                            color: root.show_colorbar ? Palette.accent-background : Palette.foreground;
                            horizontal-alignment: center;
                            font-weight: root.show_colorbar ? 600 : 400;
                            font-family: "SF Pro Text";
                        }
                    }
                }
                
                // Separator
                Rectangle {
                    width: 1px;
                    height: 52px;
                    background: Palette.border;
                }
                
                // False color map selector
                VerticalLayout {
                    spacing: 3px;
                    alignment: center;

                    Text {
                        text: "False Color";
                        color: Palette.alternate-foreground;
                        font-size: 11px;
                        font-weight: 600;
                        font-family: "SF Pro Text";
                        horizontal-alignment: center;
                    }

                    ComboBox {
                        width: 120px;
                        preferred-height: 30px;
                        model: ["Grayscale", "Hot", "Parula", "Red", "Viridis", "Inferno", "Magma"];
                        current-index: Shared.colormap == "Hot" ? 1 : (Shared.colormap == "Parula" ? 2 : (Shared.colormap == "Red" ? 3 : (Shared.colormap == "Viridis" ? 4 : (Shared.colormap == "Inferno" ? 5 : (Shared.colormap == "Magma" ? 6 : 0)))));
                        selected(value) => {
                            Shared.colormap = value;
                            Shared.view_changed();
                        }
                    }
                }

                // Separator
                Rectangle {
                    width: 1px;
                    height: 52px;
                    background: Palette.border;
                }

                // Color scale mode tri-state toggle with label
                VerticalLayout {
                    spacing: 3px;
                    alignment: center;

                    Text {
                        text: "Scale Mode";
                        color: Palette.alternate-foreground;
                        font-size: 11px;
                        font-weight: 600;
                        font-family: "SF Pro Text";
                        horizontal-alignment: center;
                    }

                    toolbar-button-scale := Rectangle {
                        width: 165px;
                        height: 30px;
                        border-radius: 4px;
                        border-width: 1px;
                        border-color: Palette.border;
                        background: Palette.alternate-background;

                        property <int> scale-state: Shared.autoscale ? 1 : (Shared.manualfc ? 2 : 0);

                        HorizontalLayout {
                            spacing: 0px;

                            // Full button
                            Rectangle {
                                background: scale-state == 0 ? Palette.accent-background : (ta-full.has-hover ? Palette.alternate-background.darker(0.05) : transparent);
                                border-top-left-radius: 4px;
                                border-bottom-left-radius: 4px;

                                ta-full := TouchArea {
                                    clicked => {
                                        Shared.autoscale = false;
                                        Shared.manualfc = false;
                                        Shared.view-changed();
                                    }
                                }

                                Text {
                                    text: "Full";
                                    color: scale-state == 0 ? Palette.background : Palette.foreground;
                                    font-size: 11px;
                                    font-weight: scale-state == 0 ? 600 : 400;
                                    font-family: "SF Pro Text";
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    min-width: 52px;
                                }
                            }

                            Rectangle {
                                width: 1px;
                                background: Palette.border;
                            }

                            // Auto button
                            Rectangle {
                                background: scale-state == 1 ? Palette.accent-background : (ta-auto.has-hover ? Palette.alternate-background.darker(0.05) : transparent);

                                ta-auto := TouchArea {
                                    clicked => {
                                        Shared.autoscale = true;
                                        Shared.manualfc = false;
                                        Shared.view-changed();
                                    }
                                }

                                Text {
                                    text: "Auto";
                                    color: scale-state == 1 ? Palette.background : Palette.foreground;
                                    font-size: 11px;
                                    font-weight: scale-state == 1 ? 600 : 400;
                                    font-family: "SF Pro Text";
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    min-width: 52px;
                                }
                            }

                            Rectangle {
                                width: 1px;
                                background: Palette.border;
                            }

                            // Manual button
                            Rectangle {
                                background: scale-state == 2 ? Palette.accent-background : (ta-manual.has-hover ? Palette.alternate-background.darker(0.05) : transparent);
                                border-top-right-radius: 4px;
                                border-bottom-right-radius: 4px;

                                ta-manual := TouchArea {
                                    clicked => {
                                        Shared.autoscale = false;
                                        Shared.manualfc = true;
                                        Shared.view-changed();
                                    }
                                }

                                Text {
                                    text: "Manual";
                                    color: scale-state == 2 ? Palette.background : Palette.foreground;
                                    font-size: 11px;
                                    font-weight: scale-state == 2 ? 600 : 400;
                                    font-family: "SF Pro Text";
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    min-width: 52px;
                                }
                            }
                        }
                    }
                }
                
                // Separator
                Rectangle {
                    width: 1px;
                    height: 52px;
                    background: Palette.border;
                }
                
                // Mouse-over pixel info with label
                VerticalLayout {
                    spacing: 3px;
                    alignment: center;
                    Text {
                        text: "Mouse Over";
                        color: Palette.alternate-foreground;
                        font-size: 11px;
                        font-weight: 600;
                        font-family: "SF Pro Text";
                        horizontal-alignment: center;
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        
                        // Pixel coordinates display
                        Rectangle {
                            height: 30px;
                            background: Palette.alternate-background;
                            border-radius: 4px;
                            border-width: 1px;
                            border-color: Palette.border;
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                spacing: 6px;
                                Text {
                                    text: "Pixel:";
                                    color: Palette.alternate-foreground;
                                    font-size: 11px;
                                    font-weight: 600;
                                    font-family: "SF Pro Text";
                                    vertical-alignment: center;
                                }

                                Text {
                                    text: root.xpix + "," + root.ypix;
                                    color: Palette.foreground;
                                    font-size: 11px;
                                    font-family: "SF Mono";
                                    vertical-alignment: center;
                                    min-width: 50px;
                                }
                            }
                        }
                        
                        // Pixel value display
                        Rectangle {
                            height: 30px;
                            background: Palette.alternate-background;
                            border-radius: 4px;
                            border-width: 1px;
                            border-color: Palette.border;
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                spacing: 6px;
                                Text {
                                    text: "Value:";
                                    color: Palette.alternate-foreground;
                                    font-size: 11px;
                                    font-weight: 600;
                                    font-family: "SF Pro Text";
                                    vertical-alignment: center;
                                }

                                Text {
                                    text: root.valatpix;
                                    color: Palette.foreground;
                                    font-size: 11px;
                                    font-family: "SF Mono";
                                    vertical-alignment: center;
                                    min-width: 40px;
                                }
                            }
                        }
                    }
                }
                
                // Spacer
                Rectangle {
                    horizontal-stretch: 1;
                }
                
                // Right-aligned info
                HorizontalLayout {
                    spacing: 12px;
                    Text {
                        text: Shared.framerate;
                        color: Palette.accent-background;
                        font-size: 13px;
                        font-family: "SF Pro Text";
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }
            }
            
            // Bottom border line
            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                width: parent.width;
                background: Palette.border;
            }
        }

        VerticalSplitPane {
            ratio: 0.6;
            top-slot := ImageViewer {
                width: 100%;
                x: 0;
                y: 0;
                height: parent.top-h;
                colormap-image: root.colormap_image;
                camframe-width <=> root.camframe_width;
                camframe-height <=> root.camframe_height;
                xpix <=> root.xpix;
                ypix <=> root.ypix;
                show-colorbar: root.show_colorbar;
                show-axes: root.show-axes;
            }

            bottom-slot := Rectangle {
                width: 100%;
                height: parent.bottom-h;
                x: 0;
                y: parent.bottom-y;
                background: Palette.background;

                property <[TabData]> tabs: [
                    { title: "Histogram", content: "" },
                    { title: "Camera Control", content: "" },
                    { title: "Logs", content: "" },
                ];
                property <int> current-tab-index: 0;

                VerticalLayout {
                    padding: 0px;
                    spacing: 0px;

                    TabBar {
                        current-index <=> bottom-slot.current-tab-index;
                        tabs <=> bottom-slot.tabs;

                        accent-color: Palette.accent-background;
                        on-surface: Palette.foreground;
                        muted: Palette.alternate-foreground;
                        hover: Palette.alternate-background;
                        border: Palette.border;

                        request-add() => {
                        }
                        request-close(index) => {
                        }
                    }

                    Rectangle {
                        background: Palette.background;
                        border-width: 0px;
                        clip: true;

                        TabPage {
                            visible: bottom-slot.current-tab-index == 0;
                            ph := PlotBox {
                                min-height: 64px;
                                preferred-height: 320px;
                                xlabel: "Pixel Value";
                                ylabel: "Counts";
                                xrange <=> Shared.histxrange;
                                yrange <=> Shared.histyrange;
                                plotdata <=> Shared.histdata;
                                xticks <=> Shared.histxticks;
                                yticks <=> Shared.histyticks;
                                ytickpad: 5rem;
                                if Shared.manualfc: dah := DragArea {
                                    x: ph.plot-x;
                                    y: ph.plot-y;
                                    width: ph.plot-width;
                                    height: ph.plot-height;
                                    fcmin <=> Shared.manualfc_min;
                                    fcmax <=> Shared.manualfc_max;
                                    range <=> Shared.histxrange;
                                    onchanged => {
                                        Shared.view_changed();
                                    }
                                }
                            }
                        }

                        TabPage {
                            visible: bottom-slot.current-tab-index == 1;
                            VerticalLayout {
                                padding: 12px;
                                spacing: 8px;
                                
                                // Header
                                HorizontalLayout {
                                    padding: 8px;
                                    spacing: 12px;
                                    Text {
                                        text: "Camera Controls";
                                        color: Palette.foreground;
                                        font-size: 18px;
                                        font-weight: 700;
                                        font-family: "SF Pro Display";
                                        vertical-alignment: center;
                                    }

                                    Rectangle {
                                        // Spacer
                                    }

                                    Text {
                                        text: Shared.framerate;
                                        color: Palette.accent-background;
                                        font-size: 15px;
                                        font-weight: 600;
                                        font-family: "SF Pro Display";
                                        vertical-alignment: center;
                                    }
                                }

                                Rectangle {
                                    height: 1px;
                                    background: Palette.border;
                                }
                                
                                // Scrollable controls area
                                Flickable {
                                    viewport-height: controls-layout.preferred-height;
                                    controls-layout := VerticalLayout {
                                        spacing: 4px;
                                        padding: 4px;
                                        for cap in Shared.svbony_capabilities: Rectangle {
                                            height: 56px;
                                            background: cap.writeable ? Palette.background : Palette.alternate-background.darker(0.05);
                                            border-radius: 8px;
                                            border-width: 1px;
                                            border-color: Palette.border;
                                            HorizontalLayout {
                                                padding-left: 16px;
                                                padding-right: 16px;
                                                padding-top: 8px;
                                                padding-bottom: 8px;
                                                spacing: 12px;
                                                
                                                // Label column
                                                VerticalLayout {
                                                    width: 140px;
                                                    spacing: 2px;
                                                    Text {
                                                        text: cap.description;
                                                        color: cap.writeable ? Palette.foreground : Palette.alternate-foreground;
                                                        font-size: 14px;
                                                        font-weight: 600;
                                                        font-family: "SF Pro Text";
                                                        vertical-alignment: center;
                                                        overflow: elide;
                                                    }

                                                    Text {
                                                        text: "Range: " + cap.minval + " - " + cap.maxval;
                                                        color: Palette.alternate-foreground;
                                                        font-size: 12px;
                                                        font-family: "SF Pro Text";
                                                        vertical-alignment: center;
                                                    }
                                                }
                                                
                                                // Slider column
                                                if cap.writeable: Rectangle {
                                                    horizontal-stretch: 1;
                                                    VerticalLayout {
                                                        alignment: center;
                                                        EnhancedSlider {
                                                            minimum: cap.minval;
                                                            maximum: cap.maxval;
                                                            value: cap.value < 0 ? cap.default : cap.value;
                                                            enabled: cap.writeable && cap.value >= 0;
                                                            changed(value) => {
                                                                // Setting a manual value turns off auto mode
                                                                Shared.svbony_cap_changed(cap.name, value);
                                                            }
                                                        }
                                                    }
                                                }
                                                
                                                // Value display
                                                if cap.writeable: Rectangle {
                                                    width: 80px;
                                                    background: Palette.alternate-background;
                                                    border-radius: 6px;
                                                    border-width: 1px;
                                                    border-color: Palette.border;
                                                    Text {
                                                        text: cap.value < 0 ? "Auto" : cap.value;
                                                        color: cap.value < 0 ? Palette.accent-background : Palette.foreground;
                                                        font-size: cap.value < 0 ? 13px : 15px;
                                                        font-weight: 600;
                                                        font-family: cap.value < 0 ? "SF Pro Text" : "SF Mono";
                                                        horizontal-alignment: center;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                                
                                                // Auto toggle
                                                if cap.auto && cap.writeable: Rectangle {
                                                    width: 80px;
                                                    VerticalLayout {
                                                        alignment: center;
                                                        spacing: 2px;
                                                        ToggleSwitch {
                                                            checked: cap.value < 0;
                                                            toggled(value) => {
                                                                if (value) {
                                                                    Shared.svbony_cap_changed(cap.name, -1);
                                                                } else {
                                                                    Shared.svbony_cap_changed(cap.name, cap.default);
                                                                }
                                                            }
                                                        }

                                                        Text {
                                                            text: "Auto";
                                                            color: Palette.alternate-foreground;
                                                            font-size: 11px;
                                                            font-family: "SF Pro Text";
                                                            horizontal-alignment: center;
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        TabPage {
                            visible: bottom-slot.current-tab-index == 2;
                            VerticalLayout {
                                padding: 18px;
                                spacing: 12px;

                                Text {
                                    text: "Logs";
                                    color: Palette.foreground;
                                    font-size: 18px;
                                    font-weight: 700;
                                }

                                Rectangle {
                                    height: 1px;
                                    background: Palette.border;
                                }

                                Text {
                                    text: "Application logs will appear here.";
                                    color: Palette.alternate-foreground;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }
                }
            }
        }
        
        // Status bar at the bottom
        statusbar := Rectangle {
            height: 28px;
            background: Palette.background;
            
            // Top border line
            Rectangle {
                y: 0;
                height: 1px;
                width: parent.width;
                background: Palette.border;
            }

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                padding-top: 4px;
                padding-bottom: 4px;
                spacing: 16px;
                
                // Camera info section
                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: "📷";
                        font-size: 12px;
                        vertical-alignment: center;
                    }

                    Text {
                        text: Shared.camera_name != "" ? Shared.camera_name : "No Camera";
                        color: Shared.camera_name != "" ? Palette.foreground : Palette.alternate-foreground;
                        font-size: 12px;
                        font-family: "SF Pro Text";
                        font-weight: 500;
                        vertical-alignment: center;
                    }
                }
                
                // Separator
                Rectangle {
                    width: 1px;
                    height: 18px;
                    background: Palette.border;
                }
                
                // Frame rate section
                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: "⚡";
                        font-size: 12px;
                        vertical-alignment: center;
                    }

                    Text {
                        text: Shared.framerate != "" ? Shared.framerate : "-- fps";
                        color: Palette.accent-background;
                        font-size: 12px;
                        font-family: "SF Mono";
                        font-weight: 500;
                        vertical-alignment: center;
                    }
                }
                
                // Separator
                Rectangle {
                    width: 1px;
                    height: 18px;
                    background: Palette.border;
                }
                
                // Resolution section
                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: "🖼️";
                        font-size: 12px;
                        vertical-alignment: center;
                    }

                    Text {
                        text: root.camframe_width + " × " + root.camframe_height;
                        color: Palette.foreground;
                        font-size: 12px;
                        font-family: "SF Mono";
                        font-weight: 500;
                        vertical-alignment: center;
                    }
                }
                
                // Separator
                Rectangle {
                    width: 1px;
                    height: 18px;
                    background: Palette.border;
                }
                
                // Statistics section
                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: "μ:";
                        color: Palette.alternate-foreground;
                        font-size: 12px;
                        font-family: "SF Pro Text";
                        font-weight: 600;
                        vertical-alignment: center;
                    }

                    Text {
                        text: root.meantext;
                        color: Palette.foreground;
                        font-size: 12px;
                        font-family: "SF Mono";
                        vertical-alignment: center;
                        min-width: 50px;
                    }

                    Text {
                        text: "σ:";
                        color: Palette.alternate-foreground;
                        font-size: 12px;
                        font-family: "SF Pro Text";
                        font-weight: 600;
                        vertical-alignment: center;
                    }

                    Text {
                        text: root.vartext;
                        color: Palette.foreground;
                        font-size: 12px;
                        font-family: "SF Mono";
                        vertical-alignment: center;
                        min-width: 50px;
                    }
                }
                
                // Spacer to push remaining items to the right
                Rectangle {
                    horizontal-stretch: 1;
                }
                
                // Scale mode indicator
                HorizontalLayout {
                    spacing: 6px;
                    Text {
                        text: "Scale:";
                        color: Palette.alternate-foreground;
                        font-size: 11px;
                        font-family: "SF Pro Text";
                        vertical-alignment: center;
                    }

                    Text {
                        text: Shared.autoscale ? "Auto" : (Shared.manualfc ? "Manual" : "Full");
                        color: Palette.accent-background;
                        font-size: 11px;
                        font-family: "SF Pro Text";
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}
