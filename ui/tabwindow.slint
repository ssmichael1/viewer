                            horizontal-alignment: center;
                            vertical-alignment: center;
                            font-size: 16px;
                        }
                    }
                }
            }

            // Tab 2: Logs
            TabPage {
                visible: root.current-index == 2;
                VerticalLayout {
                    padding: 18px;
                    spacing: 12px;

                    Text {
                        text: "Logs";
                        color: Palette.foreground;
                        font-size: 20px;
                        font-weight: 700;
                    }

                    Rectangle {
                        height: 1px;
                        background: Palette.border;
                    }

                    Text {
                        text: "Streaming logs and status go here.";
                        color: Palette.alternate-foreground;
                        wrap: word-wrap;
                        font-size: 14px;
                    }

                    Rectangle {
                        background: Palette.background;
                        border-radius: 8px;
                        border-width: 1px;
